# Copy to .env and fill in a key. .env is git- and docker-ignored: never commit it.
# With no key at all, ClaimPilot runs on the deterministic MockLLM.

# Active provider: auto | mock | openai | deepseek | groq
#   auto = first key found: LLM_API_KEY, DEEPSEEK_API_KEY, GROQ_API_KEY, OPENAI_API_KEY (else mock)
LLM_PROVIDER=auto

# DeepSeek — base URL https://api.deepseek.com (tested: deepseek-flash)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Groq — base URL https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Generic OpenAI-compatible (OpenAI, Azure OpenAI, an enterprise gateway, vLLM, Ollama...) — LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini

LLM_TIMEOUT_S=30
LLM_MAX_OUTPUT_TOKENS=600
# Each provider profile carries list prices (app/config.py). Override only if yours differ (USD per 1K tokens);
# the daily budget below is enforced with these numbers.
# LLM_PRICE_INPUT_PER_1K=
# LLM_PRICE_OUTPUT_PER_1K=

# Public-demo protection (API only). Also cap spend on the key itself in the provider's dashboard.
RATE_LIMIT_PER_MINUTE=10
DAILY_MAX_ANALYSES=300
DAILY_LLM_BUDGET_USD=1.00

# Human-in-the-loop
CONFIDENCE_THRESHOLD=0.80

# Retrieval: first pass from the claim; second pass from deterministic tool findings
RETRIEVAL_TOP_K=4
SUPPLEMENTAL_RETRIEVAL_TOP_K=2
SUPPLEMENTAL_RETRIEVAL_MIN_SCORE=0.15

# AUDIT_DB_PATH defaults to ./claimpilot.db locally and /data/claimpilot.db in Docker; leave unset unless needed
