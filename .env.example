# Copy to .env and fill in as needed. Never commit .env.

# LLM provider: auto (openai if a key is set, otherwise mock) | mock | openai
LLM_PROVIDER=auto

# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, an enterprise model gateway, vLLM, Ollama...)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_S=30

# Cost estimation only (USD per 1K tokens). Set these to your model's actual list price.
LLM_PRICE_INPUT_PER_1K=0.0004
LLM_PRICE_OUTPUT_PER_1K=0.0016

# Human-in-the-loop
CONFIDENCE_THRESHOLD=0.80

# Retrieval: first pass from the claim; second pass from deterministic tool findings
RETRIEVAL_TOP_K=4
SUPPLEMENTAL_RETRIEVAL_TOP_K=2
SUPPLEMENTAL_RETRIEVAL_MIN_SCORE=0.15

AUDIT_DB_PATH=./claimpilot.db
